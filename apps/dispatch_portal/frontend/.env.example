# ---------------------------------------------------------------------------
# AL RANA Dispatch Portal — environment configuration
# Copy to `.env` and adjust per deployment. Never commit real credentials.
# ---------------------------------------------------------------------------

# URL path under which the app is served.
# Use "/" for the domain root, or a subpath such as "/dispatch/" when the app
# is embedded into the Frappe `dispatch_portal` app.
VITE_APP_BASE_PATH=/dispatch/

# Base URL for API requests. In production this is the Frappe site origin
# (session cookie auth) or an API prefix exposed by the Frappe app.
# Do NOT hardcode localhost or external domains in source code.
VITE_API_BASE_URL=/api

# Base path used to resolve static assets (icons, images) at runtime.
# Leave empty to resolve relative to the served base path.
VITE_ASSET_BASE_URL=

# Mock data mode. "true" serves local mock data; "false" calls Frappe APIs.
VITE_API_MOCK=true
