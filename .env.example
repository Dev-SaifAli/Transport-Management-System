# Shared application settings
FRAPPE_SITE=tms.example.com
SITES_DIR=/home/frappe/frappe-bench/sites

# MariaDB - use Railway private networking values, not public endpoints
DB_HOST=mariadb.railway.internal
DB_PORT=3306
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_ROOT_USER=root
DB_ROOT_PASSWORD=CHANGE_ME_FOR_FIRST_BOOTSTRAP_ONLY
MARIADB_CHARACTER_SET=utf8mb4
MARIADB_COLLATION=utf8mb4_unicode_ci

# Redis - keep private
REDIS_CACHE_URL=redis://redis-cache.railway.internal:6379
REDIS_QUEUE_URL=redis://redis-queue.railway.internal:6379
REDIS_SOCKETIO_URL=redis://redis-queue.railway.internal:6379

# Web and websocket ports
PORT=8000
FRAPPE_SOCKETIO_PORT=9000
SOCKETIO_PORT=9000
SOCKETIO_URL=https://your-websocket-service.up.railway.app

# First deployment only
ADMIN_PASSWORD=CHANGE_ME_FOR_FIRST_BOOTSTRAP_ONLY

# Optional runtime tuning
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
RAILWAY_MIGRATE_TIMEOUT_SECONDS=900

# Optional Docker build pins
FRAPPE_REF=988e54f3c4c291e2077a83809663f123731abe76
ERPNEXT_REF=4048fb70e14d1843956fcdabb7c3cca75a1cbcdd
